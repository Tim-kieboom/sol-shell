#!/usr/bin/env bash
# The command line for sol-shell. It always points quickshell at the folder this
# script belongs to, so nobody has to type (or know) where the shell is installed:
# a checkout in ~/.config/quickshell/sol-shell and a Nix store path work the same.
#
#   sol-shell                start the shell (from Hyprland's exec-once)
#   sol-shell ipc ARGS...    talk to the running shell; same as `qs ipc ARGS...`
#   sol-shell log ARGS...    read the running shell's log; same as `qs log ARGS...`
#   sol-shell restart        stop the running shell and start this one (--dry-run: only show which)
#   sol-shell -v             print the version (also --version)
#   sol-shell problems       follow the log, showing only warnings and errors (Ctrl+C to stop)
#
# Example keybind:   sol-shell ipc call notifications toggleDoNotDisturb
set -eu

# SOL_SHELL_DIR lets the Nix package fix the folder; otherwise it is the parent of bin/
dir="${SOL_SHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"

usage() {
    sed -n '2,/^set -eu/{/^set -eu/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}" >&2
}

case "${1:-}" in
    "" | run)
        [ $# -gt 0 ] && shift
        exec quickshell -p "$dir" "$@"
        ;;
    ipc)
        shift
        exec qs ipc -p "$dir" "$@"
        ;;
    log)
        shift
        exec qs log -p "$dir" "$@"
        ;;
    problems)
        # the last 200 lines of the log first, then new ones as they come (ANSI colours stripped
        # so the match cannot miss), until the shell ends
        qs log -p "$dir" -t 200 -f | sed -u 's/\x1b\[[0-9;]*m//g' | grep --line-buffered -E 'WARN|ERROR|FATAL'
        ;;
    restart)
        # The running shells of this screen: every quickshell whose config is a sol-shell (the
        # installed one, or a checkout), whichever folder it runs from. That is the point: after a
        # rebuild the running shell is still the old build, and this command swaps it for this one.
        pids=$(quickshell list --all | awk -v display="wayland/${WAYLAND_DISPLAY:-wayland-0}" '
            function flush() { if (pid != "" && path ~ /sol-shell\/shell\.qml$/ && disp == display) print pid; pid = ""; path = ""; disp = "" }
            /^Instance / { flush() }
            /Process ID:/ { pid = $3 }
            /Config path:/ { path = $3 }
            /Display connection:/ { disp = $3 }
            END { flush() }')
        if [ "${2:-}" = "--dry-run" ]; then
            echo "would stop: ${pids:-nothing running}"
            echo "would start: $dir"
            exit 0
        fi
        # a locked screen is only unlocked by the shell that locked it: stopping it would leave
        # you with a plain color and no password field
        for pid in $pids; do
            if [ "$(quickshell ipc --pid "$pid" call lock locked 2>/dev/null)" = "true" ]; then
                echo "sol-shell: the screen is locked; unlock it first" >&2
                exit 1
            fi
        done
        for pid in $pids; do
            quickshell kill --pid "$pid" || true
        done
        # wait (up to 5 seconds) until they are gone, so the new one does not meet the old one
        for _ in $(seq 50); do
            alive=0
            for pid in $pids; do
                kill -0 "$pid" 2>/dev/null && alive=1
            done
            [ "$alive" = 0 ] && break
            sleep 0.1
        done
        quickshell -p "$dir" -d
        # Quickshell's crash handler can start a shell of its own after a crash, so a stop that crashed can leave
        # two: say so, instead of leaving two bars on top of each other with nothing said
        sleep 3
        running=$(quickshell list --all | awk -v display="wayland/${WAYLAND_DISPLAY:-wayland-0}" '
            /Config path:/ { path = $3 }
            /Display connection:/ { if (path ~ /sol-shell\/shell\.qml$/ && $3 == display) n++ }
            END { print n + 0 }')
        if [ "$running" -gt 1 ]; then
            echo "sol-shell: $running shells are running on this screen (the one that was stopped probably crashed and was started again)." >&2
            echo "           Look with \`quickshell list --all\`, and stop the extra one with \`quickshell kill --pid PID\`." >&2
            exit 1
        fi
        ;;
    -v | --version | version)
        echo "sol-shell $(cat "$dir/VERSION" 2>/dev/null || echo unknown)"
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        echo "sol-shell: unknown command '$1'" >&2
        usage
        exit 2
        ;;
esac
