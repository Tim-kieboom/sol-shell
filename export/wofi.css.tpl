/* Generated by sol-shell from export/wofi.css.tpl. Edit the template, not this
   file: it is rewritten whenever the theme changes. Use it with
   wofi --show drun --style ~/.local/state/theme/wofi.css

   The look is the shell's islands: one rounded panel in the theme's background with a thin
   border, a pill-shaped search field, and entries that are rounded like the rows of the bar's
   popups (the one under the pointer or selected gets the surface color). */

/* the window itself has no fill: the panel inside it is the island, so its corners show */
window {
    margin: 0;
    border: none;
    background-color: transparent;
    font-size: 14px;
}

#outer-box {
    margin: 0;
    padding: 6px;
    border: 1px solid {{border}};
    border-radius: 18px;
    background-color: {{backgroundAlpha}};
}

#input {
    margin: 4px 4px 6px 4px;
    padding: 8px 14px;
    border: 1px solid {{border}};
    border-radius: 18px;
    background-color: {{surface}};
    background-image: none;
    color: {{text}};
    box-shadow: none;
}

#input:focus {
    border-color: {{accent}};
    box-shadow: none;
}

#scroll {
    margin: 0 4px 4px 4px;
    background-color: transparent;
}

#inner-box {
    background-color: transparent;
}

#entry {
    margin: 1px 0;
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: 14px;
    background-color: transparent;
}

#entry:selected {
    border: 1px solid {{accent}};
    background-color: {{surface}};
    outline: none;
}

#text {
    margin-left: 8px;
    color: {{text}};
}

#text:selected {
    color: {{text}};
}

#img {
    margin-right: 4px;
}
